#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	gpio_fake: gpio_fake {
		status = "okay";
		compatible = "zephyr,gpio-fake";
		gpio-controller;
		#gpio-cells = <2>;
	};

	hbridge_switch {
		compatible = "pandora,switch-hbridge";
		component-name = "Bistablerelay";
		on-gpios = <&gpio_fake 0 GPIO_ACTIVE_HIGH>;
		off-gpios = <&gpio_fake 1 GPIO_ACTIVE_HIGH>;
		wait-time = <1000>;
		status = "okay";
	};
};
