/ {
	chosen {
		zephyr,ieee802154 = &ieee802154;
	};

        esphome {
                compatible = "nabucasa,esphome";
                entity_id = "bcf";
                friendly_name = "BeagleConnect Freedom";
                status = "okay";

		api {
			compatible = "nabucasa,esphome-api";
			status = "okay";
		};

		temperature {
			compatible = "nabucasa,esphome-sensor-temperature";
			device_name = "temperature";
			sensor = <&humidity>;
			device_class = "temperature";
		};

		humidity {
			compatible = "nabucasa,esphome-sensor-humidity";
			device_name = "humidity";
			sensor = <&humidity>;
			device_class = "humidity";
		};

		longpress {
			input = <&{/gpio_keys}>;
			compatible = "zephyr,input-longpress";
			input-codes = <INPUT_KEY_0>;
			short-codes = <INPUT_KEY_A>;
			long-codes = <INPUT_KEY_X>;
			long-delay-ms = <2000>;
		};

		factory_reset {
			compatible = "pandora,factory-reset";
			input-code = <INPUT_KEY_X>;
		};
        };
};

&ieee802154 {
	status = "okay";
};

&ieee802154g {
	status = "disabled";
};
