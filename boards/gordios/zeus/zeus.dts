/dts-v1/;

#include <ti/cc1352r7.dtsi>
#include <zephyr/dt-bindings/pinctrl/cc13xx_cc26xx-pinctrl.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define BTN_GPIO_FLAGS (GPIO_ACTIVE_LOW | GPIO_PULL_UP)

/ {
	model = "Zeus";
	compatible = "gordios,zeus";

	aliases {
		led0 = &led0;
		sw0 = &btn0;
		relay-on = &relay_on0;
		relay-off = &relay_off0;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,ieee802154 = &ieee802154;
		zephyr,code-partition = &slot0_partition;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
			label = "Green LED";
		};

		relay_on0: relay_on {
			gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
		};

		relay_off0: relay_off {
			gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
		};
	};

	keys {
		compatible = "gpio-keys";
		btn0: btn_0 {
			gpios = <&gpio0 23 BTN_GPIO_FLAGS>;
			label = "Push button 1";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/**
	 * The CC1352P LAUNCHXL has an on-board antenna switch (SKY13317-373LF) used to select the
	 * appropriate RF signal port based on the currently-used PHY.
	 *
	 * Truth table:
	 *
	 * Path        DIO28 DIO29 DIO30
	 * =========== ===== ===== =====
	 * Off         0     0     0
	 * Sub-1 GHz   0     0     1     // DIO30 mux to IOC_PORT_RFC_GPO0 for auto
	 * 2.4 GHz     1     0     0     // DIO28 mux to IOC_PORT_RFC_GPO0 for auto
	 * 20 dBm TX   0     1     0     // DIO29 mux to IOC_PORT_RFC_GPO3 for auto
	 */
	antenna_mux0: antenna_mux0 {
		compatible = "skyworks,sky13317";
		status = "okay";
		gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>, <&gpio0 6 GPIO_ACTIVE_HIGH>, \
				<&gpio0 7 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&board_ant_24g_off &board_ant_tx_pa_off &board_ant_subg_off>;
		pinctrl-1 = <&board_ant_24g_on &board_ant_tx_pa_off &board_ant_subg_off>;
		pinctrl-2 = <&board_ant_24g_on &board_ant_tx_pa_on &board_ant_subg_off>;
		pinctrl-3 = <&board_ant_24g_off &board_ant_tx_pa_off &board_ant_subg_on>;
		pinctrl-4 = <&board_ant_24g_off &board_ant_tx_pa_on &board_ant_subg_on>;
		pinctrl-names = "default", "ant_24g", "ant_24g_pa", "ant_subg", "ant_subg_pa";
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Allocate 56 KiB for mcuboot */
		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(56)>;
		};

		/* Allocate 640 KiB for application */
		slot0_partition: partition@e000 {
			label = "image-0";
			reg = <0x0000e000 DT_SIZE_K(640)>;
		};

		/* (avoid touching CCFG) */
	};
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_sck_default &spi0_mosi_default
		     &spi0_miso_default &spi0_cs0_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;

	spi_flash0: mx25l3233f@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <2000000>;
		size = <0x2000000>;
		jedec-id = [c2 20 16];

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* Allocate 640 KiB for application */
			slot1_partition: partition@0 {
				label = "image-1";
				reg = <0x00000000 DT_SIZE_K(640)>;
			};

			/* Allocate 128 KiB scratch for image swap */
			scratch_partition: partition@A0000 {
				label = "image-scratch";
				reg = <0x000a0000 DT_SIZE_K(128)>;
			};

			storage_partition: partition@c0000 {
				label = "storage";
				reg = <0x000c0000 DT_SIZE_K(1280)>;
			};
		};
	};
};

&pinctrl {
	/* UART0 */
	uart0_tx_default: uart0_tx_default {
		pinmux = <13 IOC_PORT_MCU_UART0_TX>;
		bias-disable;
	};
	uart0_rx_default: uart0_rx_default {
		pinmux = <12 IOC_PORT_MCU_UART0_RX>;
		bias-disable;
		input-enable;
	};

	/* SPI0 */
	spi0_sck_default: spi0_sck_default {
		pinmux = <20 IOC_PORT_MCU_SSI0_CLK>;
		bias-disable;
	};

	spi0_mosi_default: spi0_mosi_default {
		pinmux = <19 IOC_PORT_MCU_SSI0_TX>;
		bias-disable;
	};

	spi0_miso_default: spi0_miso_default {
		pinmux = <18 IOC_PORT_MCU_SSI0_RX>;
		bias-disable;
		input-enable;
	};

	spi0_cs0_default: spi0_cs0_default {
		pinmux = <8 IOC_PORT_GPIO>;
		bias-disable;
	};

	/* On-board antenna pinmux states */
	board_ant_24g_off: board_ant_24g_off {
		pinmux = <5 IOC_PORT_GPIO>;
		bias-disable;
	};
	board_ant_24g_on: board_ant_24g_on {
		pinmux = <5 IOC_PORT_RFC_GPO0>;
		bias-disable;
	};
	board_ant_tx_pa_off: board_ant_tx_pa_off {
		pinmux = <6 IOC_PORT_GPIO>;
		bias-disable;
	};
	board_ant_tx_pa_on: board_ant_tx_pa_on {
		pinmux = <6 IOC_PORT_RFC_GPO3>;
		bias-disable;
	};
	board_ant_subg_off: board_ant_subg_off {
		pinmux = <7 IOC_PORT_GPIO>;
		bias-disable;
	};
	board_ant_subg_on: board_ant_subg_on {
		pinmux = <7 IOC_PORT_RFC_GPO0>;
		bias-disable;
	};
};

&cpu0 {
	clock-frequency = <48000000>;
};

&trng {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_rx_default &uart0_tx_default>;
	pinctrl-names = "default";
};

&radio {
	status = "okay";
};

&ieee802154 {
	status = "okay";
};

&ieee802154g {
	status = "disabled";
};

&wdt0 {
	status = "okay";
};
